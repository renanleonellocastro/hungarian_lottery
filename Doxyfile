# =================================================
# Project information
# =================================================
PROJECT_NAME           = "Hungarian Lottery"
PROJECT_BRIEF          = "Constant time winner counting for the Hungarian lottery"
PROJECT_NUMBER         = 1.1.0
OUTPUT_DIRECTORY       = docs

# =================================================
# Build options
# =================================================
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES

# =================================================
# Input
# =================================================
INPUT                  = docs/mainpage.md \
                         include \
                         src \
                         benchmarks

RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp
INCLUDE_FILE_PATTERNS  = *.h *.hpp
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

# =================================================
# Language & parsing
# =================================================
OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = YES

ENABLE_PREPROCESSING  = YES
MACRO_EXPANSION       = YES
EXPAND_ONLY_PREDEF    = NO

# =================================================
# Include handling
# =================================================
SHOW_INCLUDE_FILES     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH     = YES

# =================================================
# Warnings
# =================================================
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# =================================================
# HTML output
# =================================================
GENERATE_HTML          = YES
HTML_OUTPUT            = html
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
FULL_PATH_NAMES        = NO

# =================================================
# Diagrams (Graphviz)
# =================================================
HAVE_DOT               = YES
DOT_NUM_THREADS        = 2

UML_LOOK               = YES

CALL_GRAPH             = YES
CALLER_GRAPH           = YES
COLLABORATION_GRAPH    = YES

# =================================================
# Source browsing
# =================================================
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# =================================================
# Misc
# =================================================
GENERATE_LATEX         = NO
QUIET                  = YES
